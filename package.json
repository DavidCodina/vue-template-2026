{
  "name": "vue-project",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "og-build-before-nuxt-ui": "run-p type-check \"build-only {@}\" --",
    "build": "run-s build-only type-check",
    "preview": "vite preview",
    "test:run": "vitest run",
    "test:all": "vitest",
    "test:unit": "vitest --project=unit",
    "test:unit:verbose": "vitest --project=unit --reporter=verbose",
    "test:unit:ui": "vitest --project=unit --ui --open=false",
    "test:storybook": "vitest --project=storybook",
    "build-only": "vite build",
    "note": "type-check is the most comprehensive. The other two just check src/ files.",
    "type-check": "vue-tsc --build",
    "typescript": "vue-tsc -p tsconfig.app.json --noEmit --pretty",
    "typescript:watch": "vue-tsc -p tsconfig.app.json --noEmit --watch",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "lint:fix": "run-s \"lint:*:fix\"",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint:fix": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@lucide/vue": "^1.45.0",
    "@nuxt/ui": "^4.11.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "clsx": "^2.1.1",
    "pinia": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.83.0",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "^1.83.0",
    "playwright": "latest",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
